APP_GAME_FRIEND_MAX_PENDING_OUT=50
APP_GAME_FRIEND_DECLINE_COOLDOWN=24h
APP_GAME_FRIEND_REQUESTS_PER_HOUR=20
APP_GAME_SEARCH_MIN_LENGTH=3
APP_GAME_SEARCH_MAX_RESULTS=20
