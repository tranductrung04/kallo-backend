STORAGE_BUCKET=change_me
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me

# ---------- Mail ----------
MAIL_HOST=localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=1025
MAIL_FROM=no-reply@kallo.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
