APP_NAME=

# ---------- Database ----------
DB_NAME=
DB_URL=jdbc:postgresql://postgres:5432/change_me
DB_USERNAME=change_me
DB_PASSWORD=change_me

# ---------- Redis ----------
PROD_REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_REFRESH_REUSE_GRACE=3000

# ---------- Google OAuth2 ----------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_JWKS_URI=change_me

# ---------- AI service (FastAPI) ----------
AI_SERVICE_URL=http://localhost:8000

# ---------- Firebase Cloud Messaging ----------
FCM_CREDENTIALS_PATH=

# ---------- Object Storage (MinIO) ----------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=change_me
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me

# ---------- Mail ----------
MAIL_HOST=localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=1025
MAIL_FROM=no-reply@kallo.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=3000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
OTP_HMAC_SECRET=change_me
APP_AUTH_MAX_LOGIN_ATTEMPTS=5
APP_AUTH_LOCK_DURATION=15m
APP_AUTH_OTP_EXPIRATION=15m
APP_AUTH_MAX_OTP_ATTEMPTS=5
APP_AUTH_RESEND_INTERVAL=5s
APP_AUTH_MAX_OTP_PER_HOUR=20

# ---------- Activity (ACT) ----------
APP_ACT_MAX_SYNC_BATCH_SIZE=500
APP_ACT_SYNC_BACKFILL_DAYS=30
APP_ACT_MANUAL_BACKFILL_DAYS=365
APP_ACT_FUTURE_TOLERANCE=5m
APP_ACT_WEIGHT_MIN_KG=20
APP_ACT_WEIGHT_MAX_KG=300
APP_ACT_WALKING_MET=3.5
APP_ACT_WALKING_SPEED_KMH=5
APP_ACT_STRIDE_FACTOR=0.415
APP_ACT_FALLBACK_CADENCE_SPM=100
APP_ACT_DEDUP_OVERLAP_RATIO=0.8
APP_ACT_TOMBSTONE_RETENTION=90d
APP_ACT_ROUTE_MAX_BYTES=102400
APP_ACT_GPS_MAX_SPEED_KMH=60
