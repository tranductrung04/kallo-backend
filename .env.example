APP_NAME=

# ---------- Database ----------
DB_NAME=
DB_URL=jdbc:postgresql://localhost:5432/change_me
DB_USERNAME=change_me
DB_PASSWORD=change_me

# ---------- Redis ----------
PROD_REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_REFRESH_REUSE_GRACE=3000

# ---------- Google OAuth2 ----------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_JWKS_URI=change_me

# ---------- AI service (FastAPI) ----------
AI_SERVICE_URL=http://localhost:8000

# ---------- Firebase Cloud Messaging ----------
FCM_CREDENTIALS_PATH=

# ---------- Object Storage (MinIO) ----------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=change_me
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me

# ---------- Mail ----------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=1025
MAIL_FROM=no-reply@kallo.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=3000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
OTP_HMAC_SECRET=change_me
APP_AUTH_MAX_LOGIN_ATTEMPTS=5
APP_AUTH_LOCK_DURATION=15m
APP_AUTH_OTP_EXPIRATION=15m
APP_AUTH_MAX_OTP_ATTEMPTS=5
APP_AUTH_RESEND_INTERVAL=60s
APP_AUTH_MAX_OTP_PER_HOUR=3
